NODE_ENV=development
PORT=4000

SQLITE_PATH=./data/swiftener.db

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

COOKIE_NAME=sw_token

# Local: http://localhost:4000  |  Production: https://swiftener.com
FRONTEND_URL=http://localhost:4000
# Optional override for OAuth redirect_uri (must match Google/GitHub console exactly)
# OAUTH_PUBLIC_ORIGIN=https://swiftener.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app_password_here
SMTP_FROM="Swiftener <no-reply@swiftener.com>"

VIEW_DEDUPE_WINDOW_HOURS=12

# OAuth (optional — buttons hidden until set)
# Callback URLs (register in each provider console):
#   Google:  {FRONTEND_URL}/auth/google/callback
#   GitHub:  {FRONTEND_URL}/auth/github/callback
# Or set full override:
# GITHUB_REDIRECT_URI=https://swiftener.com/auth/github/callback
# GOOGLE_REDIRECT_URI=https://swiftener.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
