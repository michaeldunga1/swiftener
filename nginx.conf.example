# Apex site only — https://swiftener.com → Node on 127.0.0.1:3000
# Install: sudo cp nginx.conf.example /etc/nginx/sites-available/swiftener
#          sudo ln -sf /etc/nginx/sites-available/swiftener /etc/nginx/sites-enabled/
# Certbot:  sudo certbot --nginx -d swiftener.com -d www.swiftener.com

server {
    listen 80;
    listen [::]:80;
    server_name swiftener.com www.swiftener.com;
    if ($host = www.swiftener.com) {
        return 301 https://swiftener.com$request_uri;
    }
    return 301 https://swiftener.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name swiftener.com;

    ssl_certificate /etc/letsencrypt/live/swiftener.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/swiftener.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    client_max_body_size 4m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.swiftener.com;
    ssl_certificate /etc/letsencrypt/live/swiftener.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/swiftener.com/privkey.pem;
    return 301 https://swiftener.com$request_uri;
}
